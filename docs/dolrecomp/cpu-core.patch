@@ -747,6 +781,16 @@ bool ppc_psq_load(CPUState* cpu, u8 frD, u32 ea, bool w, u8 gqr_index, bool inde
     if (!psq_check_enabled(cpu, indexed, cia))
         return false;
 
+    /* Gekko packs a GQR as
+     *     bits 0..5  store scale | 6..8  store type | 9..14 load scale | 15..17 load type
+     * (Dolphin PowerPC: UGQR { spscale : 6; stype : 3; lscale : 6; ltype : 3; }).
+     * These two functions used to read the LOAD type from bits 16..18 and the STORE type
+     * from bits 0..2, i.e. shifted by one field, so every quantized load/store took the
+     * wrong format - and a wrong format is an illegal-instruction trap here, or a
+     * silently different copy. Measured cost (handover 5c.44 G): the guest's texture
+     * install - psq_l from the decompressed arena at 0x903CD1C0 with psq_st to the
+     * texture destination - left the destination holding the free-list pattern
+     * 00000000FFFFFFFF instead of texels, for every streamed character texture. */
     u32 gqr = cpu->gqr[gqr_index & 7u];
     s32 scale = gqr_scale(gqr >> 24);
     u8 type = (u8)((gqr >> 16) & 7u);
@@ -793,7 +837,26 @@ void ppc_rfi(CPUState* cpu, u32 cia) {

+    // The recompiled title runs entirely in supervisor mode: the HLE never models a
+    // user-mode transition, and nothing in the runner ever asks for one. A PR bit
+    // arriving through SRR1 is therefore a stale/garbage context word, not a real
+    // privilege change. Restoring it silently put the CPU into user mode, so the very
+    // next rfi in the RVL OS interrupt epilogue trapped PPC_PROGRAM_PRIV (observed:
+    // PPC exception 0x00000001 / ProgramExc 0x00040000 raised at the rfi in 0x805EDC34
+    // with SRR1=0x87045FFD), killing the title->game handoff.
+    if (restored & PPC_MSR_PR) {
+        static u32 s_pr_suppressed = 0;
+        if (s_pr_suppressed < 4) {
+            s_pr_suppressed++;
+            fprintf(stderr, "[CPU] rfi: suppressed stale MSR[PR] from SRR1=0x%08X "
+                            "(srr0=0x%08X msr=0x%08X)\n", cpu->srr1, cpu->srr0, cpu->msr);
+        }
+        restored &= ~PPC_MSR_PR;
+    }
+
+    cpu->msr = (cpu->msr & ~PPC_MSR_RFI_MASK) | restored;
     cpu->msr &= ~PPC_MSR_POW;
     cpu->pc = cpu->srr0 & ~3u;
 }

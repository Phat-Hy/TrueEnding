+/* Instruction-granularity store watch (TLS_STORE_WATCH=lo,hi). The recompiler emits a
+ * tls_store_note() beside every store it lifts, carrying that store's own guest cia, so
+ * "which instruction wrote this word" stops being one block stale (TLS_WATCH_ADDR samples
+ * per dispatched block, handover 5c.45 G).
+ *
+ * It only *records* into a small ring; the runner prints the ring at end of frame. Nothing
+ * here prints: a printf on the interpreter's hot path corrupted the heap (5c.45 E1). */
+int tls_store_watch_on;
+u32 tls_store_watch_lo;
+u32 tls_store_watch_hi;
+u32 tls_store_ring_cia[64];
+u32 tls_store_ring_ea[64];
+u32 tls_store_ring_val[64];
+int tls_store_ring_n;
+
+void tls_store_watch_init(u32 lo, u32 hi) {
+    tls_store_watch_lo = lo;
+    tls_store_watch_hi = hi;
+    tls_store_watch_on = (hi > lo) ? 1 : 0;
+    tls_store_ring_n = 0;
+}
+
+void tls_store_note(u32 cia, u32 ea, u32 value) {
+    if (!tls_store_watch_on) return;
+    if (ea < tls_store_watch_lo || ea >= tls_store_watch_hi) return;
+    if (tls_store_ring_n >= 64) return;
+    tls_store_ring_cia[tls_store_ring_n] = cia;
+    tls_store_ring_ea[tls_store_ring_n] = ea;
+    tls_store_ring_val[tls_store_ring_n] = value;
+    tls_store_ring_n++;
+}
+
 void mem_write8(CPUState* cpu, u32 addr, u8 value) {
     u32 avail;
     u8* host = resolve_addr(cpu, addr, &avail);
@@ -328,28 +362,27 @@ void ppc_program_exception(CPUState* cpu, u32 cause, u32 cia) {

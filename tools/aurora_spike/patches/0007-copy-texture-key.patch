+const GXState::CopyTextureRef* find_copy_texture(const GXTexObj_& obj) noexcept {
+  if (obj.data == nullptr) {
+    return nullptr;
+  }
+  const auto& copies = g_gxState.copyTextures;
+  const GXState::CopyTextureKey key{
+      .dest = obj.data,
+      .width = obj.width(),
+      .height = obj.height(),
+      .format = static_cast<GXTexFmt>(obj.format()),
+  };
+  const GXState::CopyTextureRef* resolved = nullptr;
+  if (const auto it = copies.find(key); it != copies.end()) {
+    resolved = &it->second;
+  } else {
+    // Fallbacks, in order: the same width/height under a different format (a palette texture samples
+    // an EFB copy as indices, and one copy destination is enough for the guest's `format 11` write to
+    // be sampled through a `format 3` texobj), the newest write at the address (the pre-key behaviour:
+    // the guest bound a size nothing was copied at, and the copy written there last is a better answer
+    // than guest RAM, which aurora never writes copies into), and only then nullptr - the plain
+    // static-sampler path.
+    const GXState::CopyTextureRef* sizeMatch = nullptr;
+    const GXState::CopyTextureRef* newest = nullptr;
+    for (const auto& [copyKey, copy] : copies) {
+      if (copyKey.dest != key.dest) {
+        continue;
+      }
+      if (newest == nullptr || copy.serial > newest->serial) {
+        newest = &copy;
+      }
+      if (sizeMatch == nullptr && copyKey.width == key.width && copyKey.height == key.height) {
+        sizeMatch = &copy;
+      }
+    }
+    resolved = sizeMatch != nullptr ? sizeMatch : newest;
+  }
+  if (copy_log_enabled()) {
+    const GXState::CopyTextureRef* newest = nullptr;
+    for (const auto& [copyKey, copy] : copies) {
+      if (copyKey.dest == key.dest && (newest == nullptr || copy.serial > newest->serial)) {
+        newest = &copy;
+      }
+    }
+    copy_log_bind(key, resolved, newest);
+  }
+  return resolved;
+}

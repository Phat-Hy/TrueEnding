+/* AURORA-SPIKE (handover 5c.46 AP-BM): TLS_AURORA_COPYLOG quantifies what keying the copy-texture
+ * map by (destination, width, height, format) changes on a real stream. For every sampled texture
+ * that names a copy destination it reports whether the bind resolved to a copy written AT THE SIZE
+ * THE GUEST BOUND (`key-hit`), and whether the most recent write at that address had a DIFFERENT
+ * size (`stale-at-address`) - that second count is exactly the binds the old pointer-only map
+ * answered with the later, wrong-size copy. Inert unless set. */
+struct CopyLogStats {
+  uint64_t writes = 0;
+  uint64_t writesLogged = 0;
+  uint64_t binds = 0;
+  uint64_t keyHits = 0;
+  uint64_t sizeFallbacks = 0;
+  uint64_t stale = 0;
+  uint64_t staleLogged = 0;
+  uint64_t missing = 0;
+};
+CopyLogStats s_copyLog;
+bool copy_log_enabled() noexcept {
+  // Read on first use, not at static-init time: the harness sets these variables in its own
+  // process, and a static initializer in this translation unit would be free to run earlier.
+  static const bool enabled = std::getenv("TLS_AURORA_COPYLOG") != nullptr;
+  return enabled;
+}
+
+void copy_log_bind(const GXState::CopyTextureKey& key, const GXState::CopyTextureRef* resolved,
+                   const GXState::CopyTextureRef* newest) noexcept {
+  if (!copy_log_enabled()) {
+    return;
+  }
+  ++s_copyLog.binds;
+  if (resolved == nullptr) {
+    ++s_copyLog.missing;
+    return;
+  }
+  if (resolved->key == key) {
+    ++s_copyLog.keyHits;
+  } else {
+    ++s_copyLog.sizeFallbacks;
+  }
+  if (newest != nullptr && newest->key.width == key.width && newest->key.height == key.height &&
+      newest->key.format == key.format) {
+    return;
+  }
+  ++s_copyLog.stale;
+  if (s_copyLog.staleLogged < 12) {
+    ++s_copyLog.staleLogged;
+    std::fprintf(stderr,
+                 "[copylog] bind %p at %ux%u fmt %u -> resolved %ux%u fmt %u | newest write at this address "
+                 "%ux%u fmt %u (the pointer-only map would have used the latter)\n",
+                 key.dest, key.width, key.height, static_cast<unsigned>(key.format), resolved->key.width,
+                 resolved->key.height, static_cast<unsigned>(resolved->key.format),
+                 newest != nullptr ? newest->key.width : 0, newest != nullptr ? newest->key.height : 0,
+                 newest != nullptr ? static_cast<unsigned>(newest->key.format) : 0);
+  }
+}

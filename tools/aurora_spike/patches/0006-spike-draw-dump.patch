AP-AN also added a z-convention probe to lib/gx/regs.cpp (xf_load_projection). It is inert unless
TLS_AURORA_Z_REMAP is set, and it is recorded here as a hand-written hunk because 0004 already owns
the rest of that file's diff:

diff --git a/lib/gx/regs.cpp b/lib/gx/regs.cpp
--- a/lib/gx/regs.cpp
+++ b/lib/gx/regs.cpp
@@ -955,6 +955,17 @@ void xf_load_projection(const u8* data) noexcept {
     proj.m1[2] = p3;
     proj.m3[2] = -1.0f;
   }
+  /* AURORA-SPIKE (handover 5c.46 AP-AN): probe the z convention. GX's NDC z range and wgpu's
+   * clip-space z range are not the same thing, and this probe exists to measure which remap (if
+   * any) a replayed hardware stream needs. TLS_AURORA_Z_REMAP: 0 = 0.5*(z+w), 1 = 0.5*(w-z),
+   * 2 = (w-z). Inert unless set. */
+  if (const char* zr = std::getenv("TLS_AURORA_Z_REMAP")) {
+    const int mode = std::atoi(zr);
+    for (int i = 0; i < 4; ++i) {
+      const float z = proj[i][2], w = proj[i][3];
+      proj[i][2] = mode == 1 ? 0.5f * (w - z) : (mode == 2 ? (w - z) : 0.5f * (z + w));
+    }
+  }
   g_gxState.dirty |= DirtyUniform;
 }

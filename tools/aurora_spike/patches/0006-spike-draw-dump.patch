 static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, ByteReader& reader) noexcept {
   ZoneScoped;
+  /* AURORA-SPIKE (5c.46 AP-AN): does the frame rasterize at all, or does it rasterize black?
+   * Two independent switches, applied once per draw (they do not re-dirty the pipeline every draw):
+   *   TLS_AURORA_TEST_NO_DEPTH  - depth compare off
+   *   TLS_AURORA_TEST_WHITE_TEV - stage 0 outputs a constant white
+   * Inert unless set. */
+  static int sNoDepth = -1, sWhiteTev = -1;
+  if (sNoDepth == -1) {
+    sNoDepth = std::getenv("TLS_AURORA_TEST_NO_DEPTH") != nullptr ? 1 : 0;
+    sWhiteTev = std::getenv("TLS_AURORA_TEST_WHITE_TEV") != nullptr ? 1 : 0;
+  }
+  if (sNoDepth != 0 && g_gxState.depthCompare) {
+    g_gxState.depthCompare = false;
+    g_gxState.dirty |= DirtyPipeline;
+  }
+  if (sWhiteTev != 0) {
+    g_gxState.numTevStages = 1;
+    auto& s = g_gxState.tevStages[0];
+    s.colorPass = {GX_CC_ZERO, GX_CC_ZERO, GX_CC_ZERO, GX_CC_ONE};
+    s.colorOp = {GX_TEV_ADD, GX_TB_ZERO, GX_CS_SCALE_1, GX_TEVPREV, true};
+    s.alphaPass = {GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO};
+    s.alphaOp = {GX_TEV_ADD, GX_TB_ZERO, GX_CS_SCALE_1, GX_TEVPREV, true};
+    g_gxState.blendMode = GX_BM_NONE;
+    if (g_gxState.alphaCompare.comp0 != GX_ALWAYS) {
+      g_gxState.alphaCompare = {};
+      g_gxState.dirty |= DirtyPipeline;
+    }
+  }
+  /* TLS_AURORA_TEST_MAT_WHITE: same shape of question for the RASC input - if the frame renders
+   * when the material colour is forced to white, the colour channel measured non-zero above is
+   * not what the shader receives. Inert unless set. */
+  {
+    static int sMatWhite = -1;
+    if (sMatWhite == -1) {
+      sMatWhite = std::getenv("TLS_AURORA_TEST_MAT_WHITE") != nullptr ? 1 : 0;
+    }
+    if (sMatWhite != 0) {
+      for (auto& st : g_gxState.colorChannelState) {
+        st.matColor = {1.f, 1.f, 1.f, 1.f};
+        st.ambColor = {1.f, 1.f, 1.f, 1.f};
+      }
+    }
+  }
   u32 vtxSize;
   if (g_gxState.lastVtxFmt == fmt)
     LIKELY { vtxSize = g_gxState.lastVtxSize; }
